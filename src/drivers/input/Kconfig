DT_COMPAT_ZMK_INPUT_PS2_MOUSE := zmk,input-mouse-ps2

config ZMK_INPUT_MOUSE_PS2
	bool
	default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PS2_MOUSE))
    depends on (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
	select ZMK_MOUSE
    select PS2

config ZMK_INPUT_MOUSE_PS2_ENABLE_PS2_RESEND_CALLBACK
	bool "Get notifications from the underluing PS2 protocol driver when the received data is invalid and when a resend is requested from the peripheral. This helps the mouse driver to re-align its command buffer and prevent unexpected clicks and jerky movements. With the ps2-uart driver this option is not really necessary, but is very useful for the ps2-gpio driver where mis-transmissions are frequent."
	default n

if ZMK_INPUT_MOUSE_PS2

config ZMK_INPUT_MOUSE_PS2_POWER_ON_RESET_TIME
    int "The POR shall be timed to occur 600 ms ± 20 % from the time power is applied to the TrackPoint controller."
    default 600
    help
      Refer to IBM TrackPoint System Version 4.0 Engineering Specification - Section 2.1

config ZMK_INPUT_MOUSE_PS2_ENABLE_UROB_COMPAT
    bool "Makes the driver compatible with urob's zmk fork. His fork has commits that change the default zmk function definitions. This option adopts the code to make it compatible with his changes. Only enable it if you are using his fork or it will fail to compile."
	default n

config ZMK_INPUT_MOUSE_PS2_ENABLE_ERROR_MITIGATION
    bool "Tries to mitigate transmission errors. Only useful when using a PS2 driver that is prone to miscommunication like the GPIO bitbanging driver."
	default n

config ZMK_INPUT_MOUSE_PS2_ACCEL
    bool "Enable MCU-side non-linear acceleration for the PS/2 pointing device"
    default n
    help
      Adds a velocity-based acceleration multiplier on top of the TrackPoint's
      built-in algorithm. As input magnitude increases, the effective cursor
      speed scales non-linearly. This means a light touch stays precise while
      a moderate push covers large distances quickly, reducing finger fatigue.
      Inspired by the exponential acceleration used in trackpoint_0x15.c (I2C
      variant). Implemented with integer arithmetic only (no FPU required).

config ZMK_INPUT_MOUSE_PS2_ACCEL_FACTOR
    int "Acceleration factor (steepness of the curve, per input-unit)"
    depends on ZMK_INPUT_MOUSE_PS2_ACCEL
    default 8
    range 1 30
    help
      Controls how aggressively speed increases with input magnitude.
      mult_pct = 100 + (dist * FACTOR), capped at ACCEL_MAX_MULT_PCT.
      dist = abs(dx) + abs(dy) per PS/2 packet (typically 2-30 for a TP).
      Examples with default FACTOR=8:
        dist=5  (light)  → 1.4x
        dist=10 (medium) → 1.8x
        dist=20 (strong) → 2.6x (capped by ACCEL_MAX_MULT_PCT)
      Increase for a more aggressive curve; decrease for a gentler one.

config ZMK_INPUT_MOUSE_PS2_ACCEL_MAX_MULT_PCT
    int "Maximum acceleration multiplier (in percent, e.g. 250 = 2.5x)"
    depends on ZMK_INPUT_MOUSE_PS2_ACCEL
    default 250
    range 110 500
    help
      Upper bound for the acceleration multiplier. 250 means the cursor can
      move at most 2.5x faster than the raw TP output for any given packet.
      Higher values allow more aggressive acceleration for fast movements.

config ZMK_INPUT_MOUSE_PS2_IDLE_POWER_SAVING
    bool "Automatically power down the PS/2 pointing device when ZMK goes idle"
    default n
    select PM_DEVICE
    help
      When enabled, the driver subscribes to ZMK activity state changes. On entering
      ZMK_ACTIVITY_IDLE it disables reporting, suspends the underlying PS/2 transport
      (UART pinctrl -> sleep, SCL pulled low, RX IRQ off) and, if vcc-gpios is defined,
      cuts VCC to the device. On returning to ZMK_ACTIVITY_ACTIVE the sequence is
      reversed, Power-On-Reset is re-run, the device is re-identified and all TP
      settings are re-applied.

config ZMK_INPUT_MOUSE_PS2_IDLE_POWER_SAVING_WAKE_DELAY_MS
    int "Milliseconds to wait after VCC is restored before starting PS/2 handshake"
    depends on ZMK_INPUT_MOUSE_PS2_IDLE_POWER_SAVING
    default 200
    help
      Extra settle time after driving VCC high, before re-running Power-On-Reset.
      The POR sequence itself already waits 600ms with RST asserted, so this only
      covers LDO/cap charge time and — more importantly — gives the TP a fully
      stable VCC rail before its internal Z-force zero calibration runs.
      Shorter values (e.g. 50ms) can cause the calibration to latch a biased
      baseline, which presents as the cursor continuously drifting after wake.

config ZMK_INPUT_MOUSE_PS2_SCROLL_WDT_MS
    int "Scroll accumulator watchdog timeout in milliseconds"
    default 200
    range 50 5000
    help
      If no scroll activity is received for this many milliseconds, the scroll
      residue accumulators (X and Y) are cleared to zero. This prevents stale
      residue from the previous scroll session triggering an unexpected tick on
      the next interaction. 200ms is a good default; increase if you want residue
      to persist longer between slow scroll bursts.

endif # ZMK_INPUT_MOUSE_PS2
